@using Microsoft.AspNetCore.Identity
@inject SignInManager<OnlineMovieTicketBooking.Data.ApplicationUser> SignInManager
@inject UserManager<OnlineMovieTicketBooking.Data.ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CineMento</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Main Cinema Navigation -->
    <header class="cinema-navbar">
        <div class="container d-flex align-items-center justify-content-between">
            <!-- Left: Logo & Core Navigation -->
            <div class="d-flex align-items-center gap-4">
                <a class="brand-logo-wrap" asp-controller="Home" asp-action="Index">
                    <div class="logo-mark">
                        <svg width="38" height="38" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <defs>
                                <linearGradient id="cmLogoGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="#FFE8A3" />
                                    <stop offset="40%" stop-color="#F3B768" />
                                    <stop offset="100%" stop-color="#D97706" />
                                </linearGradient>
                                <linearGradient id="cmLogoGrad2" x1="100%" y1="0%" x2="0%" y2="100%">
                                    <stop offset="0%" stop-color="#FFFBEB" />
                                    <stop offset="60%" stop-color="#E5A65D" />
                                    <stop offset="100%" stop-color="#92400E" />
                                </linearGradient>
                            </defs>
                            <path d="M22 6C12.06 6 4 14.06 4 24C4 33.94 12.06 42 22 42C27.5 42 32.4 39.6 35.8 35.8L30.8 31.2C28.5 33.6 25.4 35 22 35C15.92 35 11 30.08 11 24C11 17.92 15.92 13 22 13C25.4 13 28.5 14.4 30.8 16.8L35.8 12.2C32.4 8.4 27.5 6 22 6Z" fill="url(#cmLogoGrad1)" />
                            <path d="M25 16.5L42 8V40L25 31.5V16.5Z" fill="url(#cmLogoGrad2)" />
                            <polygon points="19,16.5 28,24 19,31.5" fill="#FFFFFF" />
                        </svg>
                    </div>
                    <span class="brand-title">CINE<span class="brand-accent-text">MENTO</span></span>
                </a>

                <nav class="d-none d-md-flex align-items-center gap-2">
                    <a class="nav-pill-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">Home</a>
                    <a class="nav-pill-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Movie" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")"
                       asp-controller="Movie" asp-action="Index">Movies</a>
                </nav>
            </div>

            <!-- Right: Account & Admin Controls -->
            <div class="d-flex align-items-center gap-2">
                @if (SignInManager.IsSignedIn(User))
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="dropdown me-2">
                            <button class="btn btn-nav-signin dropdown-toggle"
                                    type="button" id="adminMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                Management
                            </button>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow" aria-labelledby="adminMenuDropdown" style="background-color: var(--bg-surface); border: 1px solid var(--border-glass);">
                                <li><h6 class="dropdown-header text-muted small">CATALOG</h6></li>
                                <li><a class="dropdown-item text-light" asp-controller="Movie" asp-action="Index">Manage Movies</a></li>
                                <li><a class="dropdown-item text-light" asp-controller="Theatre" asp-action="Index">Theatres</a></li>
                                <li><a class="dropdown-item text-light" asp-controller="Screen" asp-action="Index">Screens & Seats</a></li>
                                <li><a class="dropdown-item text-light" asp-controller="ShowSchedule" asp-action="Index">Show Schedules</a></li>
                                <li><hr class="dropdown-divider border-secondary border-opacity-25" /></li>
                                <li><h6 class="dropdown-header text-muted small">ORDERS</h6></li>
                                <li><a class="dropdown-item text-light" asp-controller="Booking" asp-action="AllBookings">All Bookings Ledger</a></li>
                            </ul>
                        </div>
                    }

                    <a class="btn btn-nav-signin me-2 text-decoration-none" asp-controller="Booking" asp-action="MyBookings">
                        My Bookings
                    </a>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-dark-outline btn-sm py-2 px-3" title="Log Out">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn-nav-signin text-decoration-none">
                        Sign In
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn-nav-register text-decoration-none">
                        Create Account
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- Main Content Body -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Clean Footer -->
    <footer class="cinema-footer">
        <div class="container">
            <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <span class="brand-title fs-6">CINE<span class="brand-accent-text">MENTO</span></span>
                    <span class="text-muted small">© @DateTime.Now.Year CineMento Entertainment. All rights reserved.</span>
                </div>
                <div class="d-flex align-items-center gap-3 small">
                    <a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none">Privacy Policy</a>
                    <span class="text-secondary">•</span>
                    <a asp-controller="Movie" asp-action="Index" class="text-muted text-decoration-none">Now Showing</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Mento AI Cinema Assistant Chatbot Widget -->
    <div id="mentoAiContainer">
        <!-- Floating Launcher with Greeting Tooltip -->
        <div id="mentoAiGreeting" class="mento-ai-greeting">
            <span>Need showtimes or movie suggestions? Ask <strong>Mento AI</strong></span>
            <button id="mentoGreetingDismiss" class="mento-greeting-close" title="Dismiss" type="button"><i class="bi bi-x"></i></button>
        </div>

        <!-- Floating Launcher Button -->
        <button id="mentoAiLauncher" class="mento-ai-launcher" type="button" aria-label="Open Mento AI" title="Chat with Mento AI">
            <div class="mento-ai-launcher-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2V5" stroke="#f3b768" stroke-width="2" stroke-linecap="round"/>
                    <circle cx="12" cy="2" r="1" fill="#f3b768"/>
                    <rect x="3" y="5" width="18" height="14" rx="4" fill="rgba(243, 183, 104, 0.12)" stroke="#f3b768" stroke-width="1.8"/>
                    <circle cx="8" cy="11.5" r="1.75" fill="#f3b768"/>
                    <circle cx="16" cy="11.5" r="1.75" fill="#f3b768"/>
                    <path d="M9.5 15.5H14.5" stroke="#f3b768" stroke-width="1.8" stroke-linecap="round"/>
                    <rect x="1" y="9.5" width="2" height="5" rx="1" fill="#f3b768"/>
                    <rect x="21" y="9.5" width="2" height="5" rx="1" fill="#f3b768"/>
                </svg>
            </div>
        </button>

        <!-- Chat Modal Window -->
        <div id="mentoAiModal" class="mento-ai-modal" style="display: none;">
            <!-- Header -->
            <div class="mento-ai-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="mento-ai-avatar">
                        <i class="bi bi-robot"></i>
                    </div>
                    <div>
                        <div class="mento-ai-title">Mento AI</div>
                        <div class="mento-ai-status"><span class="mento-ai-dot"></span> Online Assistant</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <button id="mentoAiReset" class="mento-ai-action-btn" title="Clear Conversation" type="button">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                    <button id="mentoAiClose" class="mento-ai-action-btn" title="Close Mento AI" type="button">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <!-- Fast Category Topic Bar -->
            <div class="mento-ai-topics">
                <button type="button" class="mento-topic-chip" data-topic="movies"><i class="bi bi-film text-warning"></i> Movies</button>
                <button type="button" class="mento-topic-chip" data-topic="pricing"><i class="bi bi-star text-warning"></i> Seating & Rates</button>
                <button type="button" class="mento-topic-chip" data-topic="booking"><i class="bi bi-ticket-detailed text-warning"></i> How to Book</button>
                <button type="button" class="mento-topic-chip" data-topic="passes"><i class="bi bi-receipt text-warning"></i> My Tickets</button>
                <button type="button" class="mento-topic-chip" data-topic="snacks"><i class="bi bi-cup-straw text-warning"></i> Food & Snacks</button>
                <button type="button" class="mento-topic-chip" data-topic="payments"><i class="bi bi-credit-card text-warning"></i> Payments</button>
                <button type="button" class="mento-topic-chip" data-topic="refunds"><i class="bi bi-shield-check text-warning"></i> Refunds</button>
                <button type="button" class="mento-topic-chip" data-topic="theatres"><i class="bi bi-soundwave text-warning"></i> Theatres & Sound</button>
            </div>

            <!-- Messages Stream Area -->
            <div id="mentoAiBody" class="mento-ai-body">
                <div class="mento-msg mento-msg-bot">
                    <div class="mento-msg-bubble">
                        Welcome to CineMento! I am <strong>Mento AI</strong>, your cinema assistant. How can I help you today?
                    </div>
                    <span class="mento-msg-time">Just now</span>
                </div>

                <!-- Quick Prompt Suggestions -->
                <div id="mentoAiQuickPrompts" class="mento-quick-prompts">
                    <button type="button" class="mento-prompt-btn" data-query="What movies are currently showing?">
                        <i class="bi bi-play-circle text-warning"></i> Now Showing Movies
                    </button>
                    <button type="button" class="mento-prompt-btn" data-query="How does ticket pricing and seating tiers work?">
                        <i class="bi bi-star text-warning"></i> Seating Tiers & Pricing
                    </button>
                    <button type="button" class="mento-prompt-btn" data-query="How do I book tickets step by step?">
                        <i class="bi bi-ticket-detailed text-warning"></i> Guided Booking Steps
                    </button>
                    <button type="button" class="mento-prompt-btn" data-query="Where can I view my booking history and tickets?">
                        <i class="bi bi-receipt text-warning"></i> My Ticket Passes
                    </button>
                    <button type="button" class="mento-prompt-btn" data-query="What are your cancellation and refund policies?">
                        <i class="bi bi-shield-check text-warning"></i> Cancellation Policy
                    </button>
                </div>
            </div>

            <!-- Input Bar -->
            <form id="mentoAiForm" class="mento-ai-footer" onsubmit="return false;">
                <input type="text" id="mentoAiInput" class="mento-ai-input" placeholder="Ask about movies, showtimes, seats..." autocomplete="off" />
                <button type="submit" id="mentoAiSend" class="mento-ai-send-btn" title="Send message">
                    <i class="bi bi-send-fill"></i>
                </button>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>