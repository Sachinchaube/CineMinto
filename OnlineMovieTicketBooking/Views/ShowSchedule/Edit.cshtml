@model OnlineMovieTicketBooking.ViewModels.ShowScheduleVM

@{
    ViewData["Title"] = "Edit Show Schedule";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-cinema-secondary btn-cinema-sm">
        <i class="bi bi-arrow-left"></i> Back to Shows
    </a>
</div>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="admin-card">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                <div class="cinema-brand-icon" style="width: 42px; height: 42px; font-size: 1.25rem;">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <h3 class="text-white fw-bold mb-0 font-display">Edit Show Pricing & Status</h3>
                    <p class="text-secondary small mb-0">Adjust ticket pricing or toggle active booking status.</p>
                </div>
            </div>

            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="ShowScheduleId" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">
                            <i class="bi bi-film"></i> Movie
                        </label>
                        <input value="@Model.Movie?.MovTitle" class="form-control" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            <i class="bi bi-display"></i> Auditorium / Screen
                        </label>
                        <input value="@Model.Screen?.ScreenName" class="form-control" readonly />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">
                            <i class="bi bi-calendar-event"></i> Show Date
                        </label>
                        <input value="@Model.ShowDate.ToString("yyyy-MM-dd")" class="form-control" readonly />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">
                            <i class="bi bi-clock"></i> Start Time
                        </label>
                        <input value="@Model.ShowStartTime" class="form-control" readonly />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">
                            <i class="bi bi-clock-history"></i> End Time
                        </label>
                        <input value="@Model.ShowEndTime" class="form-control" readonly />
                    </div>

                    <div class="col-12 mt-4">
                        <h6 class="text-white fw-bold font-display border-bottom border-secondary border-opacity-25 pb-2">
                            <i class="bi bi-currency-rupee text-warning me-1"></i> Update Tier Pricing (₹)
                        </h6>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="RegularPrice" class="form-label text-info">
                            <i class="bi bi-square"></i> Regular Price (₹)
                        </label>
                        <input asp-for="RegularPrice" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="RegularPrice" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="PremiumPrice" class="form-label text-warning">
                            <i class="bi bi-star"></i> Premium Price (₹)
                        </label>
                        <input asp-for="PremiumPrice" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="PremiumPrice" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ReclinerPrice" class="form-label text-danger">
                            <i class="bi bi-award"></i> Recliner Price (₹)
                        </label>
                        <input asp-for="ReclinerPrice" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="ReclinerPrice" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-3">
                        <div class="form-check form-switch p-0 d-flex align-items-center gap-3">
                            <input asp-for="ShowIsActive" class="form-check-input ms-0" type="checkbox" style="width: 2.5em; height: 1.3em;" id="showActiveSwitch" />
                            <label class="form-check-label text-white fw-bold" for="showActiveSwitch">
                                Active / Open for Booking
                            </label>
                        </div>
                        <span asp-validation-for="ShowIsActive" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <button type="submit" class="btn btn-cinema">
                        <i class="bi bi-check-lg"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-cinema-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}