@model IEnumerable<OnlineMovieTicketBooking.ViewModels.ShowScheduleVM>

@{
    ViewData["Title"] = "Show Schedules & Timings";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="section-subtitle">SCHEDULES</div>
            <h2 class="text-white fw-bold mb-1 font-display">
                Show Schedules & Pricing
            </h2>
            <p class="text-secondary small mb-0">Program movie screenings, allocate auditoriums, and manage tiered pricing.</p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary-cinema">
                Schedule New Show
            </a>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="admin-card text-center py-5 p-4">
            <h4 class="text-white font-display">No Shows Scheduled</h4>
            <p class="text-secondary small mb-4">Schedule movie showtimes across your screens.</p>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-primary-cinema">
                    Schedule Show
                </a>
            }
        </div>
    }
    else
    {
        <div class="admin-card">
            <div class="table-responsive">
                <table class="cinema-table">
                    <thead>
                        <tr>
                            <th>Movie</th>
                            <th>Screen</th>
                            <th>Date & Time</th>
                            <th>Regular</th>
                            <th>Premium</th>
                            <th>Recliner</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <h6 class="text-white fw-bold mb-0">
                                        @(item.Movie?.MovTitle ?? $"Movie #{item.MovieId}")
                                    </h6>
                                </td>
                                <td>
                                    <span class="badge bg-dark border border-secondary border-opacity-50 text-light">
                                        @(item.Screen?.ScreenName ?? $"Screen #{item.ScreenId}")
                                    </span>
                                </td>
                                <td>
                                    <div class="text-white fw-semibold small">@item.ShowDate.ToString("dd MMM yyyy")</div>
                                    <small class="text-muted">@item.ShowStartTime - @item.ShowEndTime</small>
                                </td>
                                <td><span class="text-white font-monospace">₹@item.RegularPrice</span></td>
                                <td><span class="text-info font-monospace">₹@item.PremiumPrice</span></td>
                                <td><span class="text-warning font-monospace">₹@item.ReclinerPrice</span></td>
                                <td>
                                    @if (item.ShowIsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-muted border border-secondary border-opacity-25 px-2 py-1">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@item.ShowScheduleId" class="btn btn-dark-outline btn-sm" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.ShowScheduleId" class="btn btn-dark-outline btn-sm" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.ShowScheduleId" class="btn btn-danger btn-sm" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>