@model OnlineMovieTicketBooking.ViewModels.ShowScheduleVM

@{
    ViewData["Title"] = "Schedule New Show";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-cinema-secondary btn-cinema-sm">
        <i class="bi bi-arrow-left"></i> Back to Shows
    </a>
</div>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="admin-card">
            <div class="d-flex align-items-center gap-2 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                <div class="cinema-brand-icon" style="width: 36px; height: 36px; font-size: 1.1rem;">
                    <i class="bi bi-calendar-plus"></i>
                </div>
                <div>
                    <h3 class="text-white fw-bold mb-0 font-display">Schedule Movie Show</h3>
                    <p class="text-secondary small mb-0">Select movie, auditorium screen, show date/time, and define tier pricing.</p>
                </div>
            </div>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="MovieId" class="form-label">Movie</label>
                        <select asp-for="MovieId" class="form-select" asp-items="ViewBag.Movies">
                            <option value="">Select Movie</option>
                        </select>
                        <span asp-validation-for="MovieId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ScreenId" class="form-label">Auditorium / Screen</label>
                        <select asp-for="ScreenId" class="form-select" asp-items="ViewBag.Screens">
                            <option value="">Select Screen</option>
                        </select>
                        <span asp-validation-for="ScreenId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ShowDate" class="form-label">Show Date</label>
                        <input asp-for="ShowDate" type="date" class="form-control" />
                        <span asp-validation-for="ShowDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ShowStartTime" class="form-label">Start Time</label>
                        <input asp-for="ShowStartTime" type="time" class="form-control" />
                        <span asp-validation-for="ShowStartTime" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-4">
                        <h6 class="text-white fw-bold font-display border-bottom border-secondary border-opacity-25 pb-2">
                            <i class="bi bi-currency-rupee text-danger me-1"></i> Seat Pricing Configuration (₹)
                        </h6>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="RegularPrice" class="form-label">Regular Price (₹)</label>
                        <input asp-for="RegularPrice" type="number" step="0.01" class="form-control" placeholder="e.g. 150.00" />
                        <span asp-validation-for="RegularPrice" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="PremiumPrice" class="form-label">Premium Price (₹)</label>
                        <input asp-for="PremiumPrice" type="number" step="0.01" class="form-control" placeholder="e.g. 250.00" />
                        <span asp-validation-for="PremiumPrice" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ReclinerPrice" class="form-label">Recliner Price (₹)</label>
                        <input asp-for="ReclinerPrice" type="number" step="0.01" class="form-control" placeholder="e.g. 400.00" />
                        <span asp-validation-for="ReclinerPrice" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-3">
                        <div class="form-check form-switch p-0 d-flex align-items-center gap-3">
                            <input asp-for="ShowIsActive" class="form-check-input ms-0" type="checkbox" style="width: 2.5em; height: 1.3em;" id="showActiveSwitch" />
                            <label class="form-check-label text-white fw-bold" for="showActiveSwitch">
                                Active / Open for Booking
                            </label>
                        </div>
                        <span asp-validation-for="ShowIsActive" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <button type="submit" class="btn btn-cinema">
                        <i class="bi bi-check-lg"></i> Schedule Show
                    </button>
                    <a asp-action="Index" class="btn btn-cinema-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}