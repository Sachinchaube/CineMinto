@model List<OnlineMovieTicketBooking.Models.BookingModel>

@{
    ViewData["Title"] = "My Bookings";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="section-subtitle">TICKETS & RESERVATIONS</div>
            <h2 class="text-white fw-bold mb-1 font-display">
                My Bookings & Passes
            </h2>
            <p class="text-secondary small mb-0">
                View your upcoming showtimes, access e-tickets, and review past cinema reservations.
            </p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary-cinema btn-sm">
            Book More Tickets
        </a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="admin-card text-center py-5 p-4">
            <div class="mb-3 text-muted">
                <i class="bi bi-ticket-perforated fs-1"></i>
            </div>
            <h4 class="text-white font-display">No Active Bookings Found</h4>
            <p class="text-secondary max-w-md mx-auto mb-4">
                Looks like you haven't booked any movie tickets yet. Explore what's playing right now!
            </p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary-cinema">
                Discover Movies
            </a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-10 mx-auto">
                @foreach (var booking in Model)
                {
                    var isConfirmed = booking.BookingStatus.ToString().Equals("Confirmed", StringComparison.OrdinalIgnoreCase);
                    var isPending = booking.BookingStatus.ToString().Equals("Pending", StringComparison.OrdinalIgnoreCase);

                    <div class="ticket-card mb-4" style="background: var(--bg-surface); border: 1px solid var(--border-glass); border-radius: var(--radius-lg); overflow: hidden;">
                        <div class="p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    @if (isConfirmed)
                                    {
                                        <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-30 px-3 py-1 fw-bold">Confirmed</span>
                                    }
                                    else if (isPending)
                                    {
                                        <span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-30 px-3 py-1 fw-bold">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 px-3 py-1 fw-bold">Cancelled</span>
                                    }
                                </div>
                                <span class="text-secondary small">Booking Ref: <strong class="text-white font-monospace">@booking.BookingReference</strong></span>
                            </div>

                            <h3 class="text-white fw-bold mb-2 font-display">
                                @(booking.ShowSchedule?.Movie?.MovTitle ?? "Movie Title")
                            </h3>

                            <div class="d-flex flex-wrap align-items-center gap-3 text-secondary small mb-3">
                                <span><strong class="text-white">Theatre:</strong> @(booking.ShowSchedule?.Screen?.Theatre?.TheaName ?? "Theatre")</span>
                                <span>•</span>
                                <span><strong class="text-white">Screen:</strong> @(booking.ShowSchedule?.Screen?.ScreenName ?? "Screen 1")</span>
                                <span>•</span>
                                <span><strong class="text-white">Date:</strong> @(booking.ShowSchedule?.ShowDate.ToString("ddd, dd MMM yyyy") ?? "-")</span>
                                <span>•</span>
                                <span><strong class="text-white">Time:</strong> @(booking.ShowSchedule?.ShowStartTime.ToString(@"hh\:mm") ?? "-")</span>
                            </div>

                            <div class="d-flex align-items-center justify-content-between pt-3 border-top border-secondary border-opacity-25">
                                <div>
                                    <small class="text-muted d-block">Total Paid</small>
                                    <span class="text-warning fw-bold fs-4 font-display">₹@booking.TotalAmount</span>
                                </div>
                                <div>
                                    <a asp-action="Details"
                                       asp-route-bookingId="@booking.BookingId"
                                       class="btn btn-dark-outline btn-sm px-3">
                                        View E-Ticket
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>