@model IEnumerable<OnlineMovieTicketBooking.ViewModels.ScreenVM>

@{
    ViewData["Title"] = "Auditoriums & Screens";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="section-subtitle">SCREENS</div>
            <h2 class="text-white fw-bold mb-1 font-display">
                Auditoriums & Screens
            </h2>
            <p class="text-secondary small mb-0">Manage cinema screens, seating capacities (Regular, Premium, Recliner), and formats.</p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary-cinema">
                Add New Screen
            </a>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="admin-card text-center py-5 p-4">
            <h4 class="text-white font-display">No Screens Configured</h4>
            <p class="text-secondary small mb-4">Add screens and seat capacities for your theatre branches.</p>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-primary-cinema">
                    Add Screen
                </a>
            }
        </div>
    }
    else
    {
        <div class="admin-card">
            <div class="table-responsive">
                <table class="cinema-table">
                    <thead>
                        <tr>
                            <th>Screen & Theatre</th>
                            <th>Total Capacity</th>
                            <th>Tier Breakdown</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div>
                                        <h6 class="text-white fw-bold mb-0">@item.ScreenName</h6>
                                        <small class="text-muted">@(item.Theatre?.TheaName ?? "Branch")</small>
                                    </div>
                                </td>
                                <td>
                                    <span class="fs-6 fw-bold text-white font-monospace">@item.TotalSeats</span> <span class="text-muted small">seats</span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap">
                                        <span class="badge bg-dark border border-secondary border-opacity-50 text-light small" title="Regular Seats">R: @item.RegularSeats</span>
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 small" title="Premium Seats">P: @item.PremiumSeats</span>
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 small" title="Recliner Seats">VIP: @item.ReclinerSeats</span>
                                    </div>
                                </td>
                                <td>
                                    @if (item.ScreenIsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-muted border border-secondary border-opacity-25 px-2 py-1">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@item.ScreenId" class="btn btn-dark-outline btn-sm" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.ScreenId" class="btn btn-dark-outline btn-sm" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.ScreenId" class="btn btn-danger btn-sm" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>