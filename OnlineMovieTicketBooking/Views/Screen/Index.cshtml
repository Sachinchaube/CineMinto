@model IEnumerable<OnlineMovieTicketBooking.ViewModels.ScreenVM>

@{
    ViewData["Title"] = "Auditoriums & Screens";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="nav-admin-badge">ADMIN</span>
            <h2 class="text-white fw-bold mb-0 font-display">Auditoriums & Screens</h2>
        </div>
        <p class="text-secondary small mb-0">Manage cinema screens, seating capacities (Regular, Premium, Recliner), and formats.</p>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-cinema">
            <i class="bi bi-plus-lg"></i> Add New Screen
        </a>
    }
</div>

@if (Model == null || !Model.Any())
{
    <div class="admin-card text-center py-5">
        <i class="bi bi-display text-muted display-4 mb-3"></i>
        <h4 class="text-white font-display">No Screens Configured</h4>
        <p class="text-secondary">Add screens and seat capacities for your theatre branches.</p>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-cinema">
                <i class="bi bi-plus-lg"></i> Add Screen
            </a>
        }
    </div>
}
else
{
    <div class="admin-card">
        <div class="table-responsive">
            <table class="cinema-table">
                <thead>
                    <tr>
                        <th>Screen & Theatre</th>
                        <th>Regular Seats</th>
                        <th>Premium Seats</th>
                        <th>Recliner Seats</th>
                        <th>Total Capacity</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="cinema-brand-icon" style="width: 36px; height: 36px; font-size: 1rem; border-radius: 8px;">
                                        <i class="bi bi-display"></i>
                                    </div>
                                    <div>
                                        <h6 class="text-white fw-bold mb-0">@item.ScreenName</h6>
                                        <span class="text-muted small">
                                            <i class="bi bi-geo-alt me-1 text-danger"></i>@(item.Theatre?.TheaName ?? "Theatre")
                                        </span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-secondary bg-opacity-25 text-white">@item.RegularSeats</span>
                            </td>
                            <td>
                                <span class="badge bg-primary bg-opacity-25 text-primary">@item.PremiumSeats</span>
                            </td>
                            <td>
                                <span class="badge bg-warning bg-opacity-25 text-warning">@item.ReclinerSeats</span>
                            </td>
                            <td>
                                <strong class="text-info font-display">@item.TotalSeats</strong>
                            </td>
                            <td>
                                @if (item.ScreenIsActive)
                                {
                                    <span class="status-badge success">Active</span>
                                }
                                else
                                {
                                    <span class="status-badge cancelled">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@item.ScreenId" class="btn btn-cinema-secondary btn-cinema-sm" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.ScreenId" class="btn btn-cinema-secondary btn-cinema-sm" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.ScreenId" class="btn btn-cinema-danger btn-cinema-sm" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}