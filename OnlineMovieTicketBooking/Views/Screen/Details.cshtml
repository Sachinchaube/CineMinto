@model OnlineMovieTicketBooking.ViewModels.ScreenVM

@{
    ViewData["Title"] = Model?.ScreenName ?? "Screen Details";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-cinema-secondary btn-cinema-sm">
        <i class="bi bi-arrow-left"></i> Back to Screens
    </a>
</div>

<div class="row">
    <div class="col-lg-6 mx-auto">
        <div class="admin-card">
            <div class="d-flex align-items-center gap-2 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                <div class="cinema-brand-icon" style="width: 36px; height: 36px; font-size: 1.1rem;">
                    <i class="bi bi-display"></i>
                </div>
                <div>
                    <h3 class="text-white fw-bold mb-0 font-display">@Model?.ScreenName</h3>
                    <p class="text-secondary small mb-0">@(Model?.Theatre?.TheaName ?? "Theatre") Auditorium</p>
                </div>
            </div>

            <div class="p-3 bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-25 mb-4">
                <div class="d-flex justify-content-between mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                    <span class="text-muted small">Theatre</span>
                    <strong class="text-white">@(Model?.Theatre?.TheaName ?? "Theatre")</strong>
                </div>
                <div class="d-flex justify-content-between mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                    <span class="text-muted small">Screen Name</span>
                    <strong class="text-white">@Model?.ScreenName</strong>
                </div>
                <div class="d-flex justify-content-between mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                    <span class="text-muted small">Regular Capacity</span>
                    <span class="text-white">@Model?.RegularSeats Seats</span>
                </div>
                <div class="d-flex justify-content-between mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                    <span class="text-muted small">Premium Capacity</span>
                    <span class="text-white">@Model?.PremiumSeats Seats</span>
                </div>
                <div class="d-flex justify-content-between mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                    <span class="text-muted small">Recliner Capacity</span>
                    <span class="text-white">@Model?.ReclinerSeats Seats</span>
                </div>
                <div class="d-flex justify-content-between mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                    <span class="text-muted small">Total Capacity</span>
                    <strong class="text-info font-display fs-5">@Model?.TotalSeats Seats</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted small">Operational Status</span>
                    @if (Model?.ScreenIsActive == true)
                    {
                        <span class="status-badge success">Active</span>
                    }
                    else
                    {
                        <span class="status-badge cancelled">Inactive</span>
                    }
                </div>
            </div>

            <div class="d-flex gap-2">
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@Model?.ScreenId" class="btn btn-cinema">
                        <i class="bi bi-pencil"></i> Edit Screen
                    </a>
                }
                <a asp-action="Index" class="btn btn-cinema-secondary">
                    Back to Screens
                </a>
            </div>
        </div>
    </div>
</div>