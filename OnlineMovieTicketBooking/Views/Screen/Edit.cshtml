@model OnlineMovieTicketBooking.ViewModels.ScreenVM

@{
    ViewData["Title"] = "Edit Screen";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-cinema-secondary btn-cinema-sm">
        <i class="bi bi-arrow-left"></i> Back to Screens
    </a>
</div>

<div class="row">
    <div class="col-lg-7 mx-auto">
        <div class="admin-card">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                <div class="cinema-brand-icon" style="width: 42px; height: 42px; font-size: 1.25rem;">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <h3 class="text-white fw-bold mb-0 font-display">Edit Auditorium Details</h3>
                    <p class="text-secondary small mb-0">Update screen name and active state for this auditorium.</p>
                </div>
            </div>

            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="ScreenId" />
                <input type="hidden" asp-for="TheatreId" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">
                            <i class="bi bi-building"></i> Theatre Branch
                        </label>
                        <input value="@Model.Theatre?.TheaName" class="form-control" readonly />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ScreenName" class="form-label">
                            <i class="bi bi-tv"></i> Screen Name
                        </label>
                        <input asp-for="ScreenName" class="form-control" />
                        <span asp-validation-for="ScreenName" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-4">
                        <h6 class="text-white fw-bold font-display border-bottom border-secondary border-opacity-25 pb-2">
                            <i class="bi bi-grid-3x3 text-warning me-1"></i> Configured Seating Capacity (Fixed Layout)
                        </h6>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="RegularSeats" class="form-label text-info">
                            <i class="bi bi-square"></i> Regular
                        </label>
                        <input asp-for="RegularSeats" class="form-control" readonly />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="PremiumSeats" class="form-label text-warning">
                            <i class="bi bi-star"></i> Premium
                        </label>
                        <input asp-for="PremiumSeats" class="form-control" readonly />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="ReclinerSeats" class="form-label text-danger">
                            <i class="bi bi-award"></i> Recliner
                        </label>
                        <input asp-for="ReclinerSeats" class="form-control" readonly />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="TotalSeats" class="form-label text-success">
                            <i class="bi bi-pie-chart"></i> Total
                        </label>
                        <input asp-for="TotalSeats" class="form-control fw-bold" readonly />
                    </div>

                    <div class="col-12 mt-3">
                        <div class="form-check form-switch p-0 d-flex align-items-center gap-3">
                            <input asp-for="ScreenIsActive" class="form-check-input ms-0" type="checkbox" style="width: 2.5em; height: 1.3em;" id="screenActiveSwitch" />
                            <label class="form-check-label text-white fw-bold" for="screenActiveSwitch">
                                Active / Operational Screen
                            </label>
                        </div>
                        <span asp-validation-for="ScreenIsActive" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <button type="submit" class="btn btn-cinema">
                        <i class="bi bi-check-lg"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-cinema-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}