@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="admin-card p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4 border-bottom border-secondary border-opacity-25 pb-4">
                    <div class="p-3 rounded-circle bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-shield-check fs-2"></i>
                    </div>
                    <div>
                        <h1 class="h2 fw-bold text-white mb-1">CineMento Privacy Policy</h1>
                        <p class="text-muted small mb-0">Last updated: September 2026</p>
                    </div>
                </div>

                <div class="vstack gap-4 text-light opacity-90">
                    <section>
                        <h4 class="text-white fw-bold mb-2">1. Information We Collect</h4>
                        <p class="text-muted">
                            When you register an account or book tickets through CineMento, we collect your name, email address, contact phone number, and transaction identifiers. We do not store sensitive payment card details directly on our servers.
                        </p>
                    </section>

                    <section>
                        <h4 class="text-white fw-bold mb-2">2. How We Use Your Data</h4>
                        <p class="text-muted">
                            Your information is strictly utilized to process your cinema ticket reservations, issue electronic booking vouchers, provide showtime alerts, and process customer support inquiries.
                        </p>
                    </section>

                    <section>
                        <h4 class="text-white fw-bold mb-2">3. Data Security & Encryption</h4>
                        <p class="text-muted">
                            We implement industry-standard 256-bit SSL encryption across all communication endpoints to safeguard your authentication tokens and booking data against unauthorized access.
                        </p>
                    </section>

                    <section>
                        <h4 class="text-white fw-bold mb-2">4. Contact Us</h4>
                        <p class="text-muted mb-0">
                            If you have questions about our privacy policies or data protection, reach out to our privacy team at <a href="mailto:privacy@cinemento.com" class="text-warning text-decoration-none">privacy@cinemento.com</a>.
                        </p>
                    </section>
                </div>

                <div class="mt-5 pt-3 text-end border-top border-secondary border-opacity-25">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary-cinema">
                        Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
