@model List<OnlineMovieTicketBooking.Models.MovieModel>

@{
    ViewData["Title"] = "Book Movie Tickets Online";
    var featuredMovie = Model?.FirstOrDefault();
}

<div class="container hero-container">
    <!-- Hero Section -->
    <div class="row align-items-center g-5 mb-5 pb-3">
        <!-- Left: Hero Copy & Search Bar -->
        <div class="col-lg-7">
            <h1 class="hero-heading">
                Book Movie Tickets Online with Ease
            </h1>
            
            <p class="hero-description">
                Browse the latest releases, find showtimes at top multiplexes near you, select your preferred seats, and get instant digital passes.
            </p>

            <div class="search-bar-wrap">
                <i class="bi bi-search"></i>
                <input type="text"
                       id="movieSearchInput"
                       class="search-bar-input"
                       placeholder="Search by movie title, language or genre..." />
                <button type="button" class="btn-search-shows" onclick="document.getElementById('now-showing').scrollIntoView({ behavior: 'smooth' });">
                    Search Shows
                </button>
            </div>
        </div>

        <!-- Right: Featured Spotlight Poster -->
        <div class="col-lg-5 d-none d-lg-block">
            @if (featuredMovie != null)
            {
                <div class="hero-featured-card">
                    <img src="@(string.IsNullOrEmpty(featuredMovie.MovPosterUrl) ? "https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&fit=crop&w=800&q=80" : featuredMovie.MovPosterUrl)"
                         alt="@featuredMovie.MovTitle"
                         class="hero-featured-img"
                         onerror="this.src='https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&fit=crop&w=800&q=80';" />
                    
                    <div class="hero-rating-badge">
                        9.2 / 10
                    </div>

                    <div class="hero-featured-action">
                        @{
                            var nextShow = featuredMovie.ShowSchedules?.FirstOrDefault(s => s.ShowIsActive);
                        }
                        @if (nextShow != null)
                        {
                            <a asp-controller="Booking" asp-action="SelectSeats" asp-route-showScheduleId="@nextShow.ShowScheduleId" class="btn-hero-book text-decoration-none">
                                Select Showtimes
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Movie" asp-action="Details" asp-route-id="@featuredMovie.MovieId" class="btn-hero-book text-decoration-none">
                                View Movie Details
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Now Showing Section -->
    <div id="now-showing" class="pt-4 mb-5">
        <div class="d-flex align-items-end justify-content-between mb-4">
            <div>
                <div class="section-subtitle">CURRENT SCHEDULE</div>
                <h2 class="section-title">Now Showing in Theatres</h2>
            </div>
            <div>
                <a asp-controller="Movie" asp-action="Index" class="btn-catalog-pill text-decoration-none">
                    View Full Catalog
                </a>
            </div>
        </div>

        @if (Model == null || Model.Count == 0)
        {
            <div class="admin-card text-center py-5 p-4">
                <h4 class="text-white">No Movies Currently Scheduled</h4>
                <p class="text-secondary small max-w-md mx-auto mb-4">
                    New movie showtimes and blockbuster schedules will be listed shortly.
                </p>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Movie" asp-action="Create" class="btn btn-primary-cinema">
                        Add New Movie
                    </a>
                }
            </div>
        }
        else
        {
            <div class="row g-4" id="movieCardGrid">
                @foreach (var movie in Model)
                {
                    var activeShows = movie.ShowSchedules?.Where(s => s.ShowIsActive).OrderBy(s => s.ShowDate).ThenBy(s => s.ShowStartTime).ToList();
                    var primaryShow = activeShows?.FirstOrDefault();

                    <div class="col-xl-3 col-lg-4 col-sm-6 movie-search-card"
                         data-title="@(movie.MovTitle?.ToLower() ?? "")"
                         data-genre="@(movie.MovGenre?.ToLower() ?? "")"
                         data-language="@(movie.MovLanguage?.ToLower() ?? "")">
                        
                        <div class="movie-card-clean">
                            <div class="movie-poster-wrap">
                                <img src="@(string.IsNullOrEmpty(movie.MovPosterUrl) ? "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=600&q=80" : movie.MovPosterUrl)"
                                     alt="@movie.MovTitle"
                                     onerror="this.src='https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=600&q=80';" />
                                
                                <div class="movie-card-rating">
                                    9.2 / 10
                                </div>

                                <div class="movie-card-book-wrap">
                                    @if (primaryShow != null)
                                    {
                                        <a asp-controller="Booking" asp-action="SelectSeats" asp-route-showScheduleId="@primaryShow.ShowScheduleId" class="btn-book-tickets">
                                            Book Tickets
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Movie" asp-action="Details" asp-route-id="@movie.MovieId" class="btn-book-tickets">
                                            View Details
                                        </a>
                                    }
                                </div>
                            </div>

                            <div class="movie-details-clean">
                                <div>
                                    <h5 class="movie-title-clean" title="@movie.MovTitle">
                                        <a asp-controller="Movie" asp-action="Details" asp-route-id="@movie.MovieId" class="text-white text-decoration-none">
                                            @movie.MovTitle
                                        </a>
                                    </h5>
                                    <div class="movie-meta-clean">
                                        @(string.IsNullOrEmpty(movie.MovLanguage) ? "English" : movie.MovLanguage) • @movie.MovDuration min
                                    </div>
                                </div>
                                <div class="movie-tags-clean mb-2">
                                    @if (!string.IsNullOrEmpty(movie.MovGenre))
                                    {
                                        <span class="tag-chip">@movie.MovGenre</span>
                                    }
                                    <span class="tag-chip">@movie.MovRelDate.Year</span>
                                </div>

                                <!-- Available Showtimes Slots -->
                                @if (activeShows != null && activeShows.Any())
                                {
                                    <div class="mt-2 pt-2 border-top border-secondary border-opacity-25">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <small class="text-warning fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">AVAILABLE SHOWTIMES</small>
                                            <small class="text-muted" style="font-size: 0.7rem;">@activeShows.Count slots</small>
                                        </div>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var show in activeShows)
                                            {
                                                <a asp-controller="Booking"
                                                   asp-action="SelectSeats"
                                                   asp-route-showScheduleId="@show.ShowScheduleId"
                                                   class="btn-showtime-slot"
                                                   title="@(show.Screen?.Theatre?.TheaName) - @(show.Screen?.ScreenName) | @show.ShowDate.ToString("dd MMM yyyy")">
                                                    <span class="fw-bold text-white">@show.ShowStartTime.ToString(@"hh\:mm")</span>
                                                    <span class="slot-date">@show.ShowDate.ToString("dd MMM")</span>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="mt-2 pt-2 border-top border-secondary border-opacity-25">
                                        <small class="text-muted" style="font-size: 0.75rem;">No active showtimes</small>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- No Results Found Indicator for Search Filter -->
            <div id="noSearchResults" class="admin-card text-center py-5 d-none mt-4">
                <i class="bi bi-search text-muted fs-2 mb-2"></i>
                <h5 class="text-white">No Matching Movies Found</h5>
                <p class="text-muted small mb-0">Try searching for a different title, genre, or language.</p>
            </div>
        }
    </div>
</div>