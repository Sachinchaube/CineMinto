@model IEnumerable<OnlineMovieTicketBooking.ViewModels.MovieVM>

@{
    ViewData["Title"] = "Movies Catalogue";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="section-subtitle">CATALOGUE</div>
            <h2 class="text-white fw-bold mb-1 font-display">
                Movies Directory
            </h2>
            <p class="text-secondary small mb-0">Browse all movies, manage releases, and update movie information.</p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary-cinema">
                Add New Movie
            </a>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="admin-card text-center py-5 p-4">
            <h4 class="text-white font-display">No Movies Found</h4>
            <p class="text-secondary small mb-4">Get started by creating your first movie entry.</p>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-primary-cinema">
                    Add Movie
                </a>
            }
        </div>
    }
    else
    {
        <div class="admin-card">
            <div class="table-responsive">
                <table class="cinema-table">
                    <thead>
                        <tr>
                            <th>Movie</th>
                            <th>Genre & Language</th>
                            <th>Duration</th>
                            <th>Release Date</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div style="width: 48px; height: 68px; flex-shrink: 0; border-radius: 6px; overflow: hidden; background: #162238;">
                                            @if (!string.IsNullOrEmpty(item.MovPosterUrl))
                                            {
                                                <img src="@item.MovPosterUrl" alt="@item.MovTitle" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.style.display='none';" />
                                            }
                                            else
                                            {
                                                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                                                    <i class="bi bi-film"></i>
                                                </div>
                                            }
                                        </div>
                                        <div>
                                            <h6 class="text-white fw-bold mb-1">@item.MovTitle</h6>
                                            <p class="text-muted small mb-0 text-truncate" style="max-width: 260px;">
                                                @item.MovDescription
                                            </p>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-dark border border-secondary border-opacity-50 text-light me-1">@item.MovGenre</span>
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">@item.MovLanguage</span>
                                </td>
                                <td>
                                    <span class="text-light small"><i class="bi bi-clock text-warning me-1"></i>@item.MovDuration mins</span>
                                </td>
                                <td>
                                    <span class="text-secondary small">@item.MovRelDate.ToString("dd MMM yyyy")</span>
                                </td>
                                <td>
                                    @if (item.MovIsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-muted border border-secondary border-opacity-25 px-2 py-1">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@item.MovieId" class="btn btn-dark-outline btn-sm" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.MovieId" class="btn btn-dark-outline btn-sm" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.MovieId" class="btn btn-danger btn-sm" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>