@model OnlineMovieTicketBooking.ViewModels.MovieVM

@{
    ViewData["Title"] = Model?.MovTitle ?? "Movie Details";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-dark-outline btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Catalogue
        </a>
    </div>

    <div class="admin-card p-4 p-md-5">
        <div class="row g-4">
            <!-- Movie Poster Column -->
            <div class="col-md-4 col-lg-3 text-center">
                <div class="movie-poster-wrap rounded-4 shadow-lg overflow-hidden border border-secondary border-opacity-25" style="max-width: 280px; height: 380px; margin: 0 auto;">
                    @if (!string.IsNullOrEmpty(Model?.MovPosterUrl))
                    {
                        <img src="@Model.MovPosterUrl"
                             alt="@Model.MovTitle"
                             style="width: 100%; height: 100%; object-fit: cover;"
                             onerror="this.src='https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=600&q=80';" />
                    }
                    else
                    {
                        <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                            <i class="bi bi-film fs-1"></i>
                        </div>
                    }
                </div>
            </div>

            <!-- Movie Details Column -->
            <div class="col-md-8 col-lg-9">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    @if (!string.IsNullOrEmpty(Model?.MovGenre))
                    {
                        <span class="badge bg-dark border border-secondary border-opacity-50 text-light">@Model.MovGenre</span>
                    }
                    @if (!string.IsNullOrEmpty(Model?.MovLanguage))
                    {
                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">@Model.MovLanguage</span>
                    }
                    @if (Model?.MovIsActive == true)
                    {
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Now Showing</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary bg-opacity-10 text-muted border border-secondary border-opacity-25 px-2 py-1">Inactive</span>
                    }
                </div>

                <h1 class="hero-heading mb-2 fs-2">@Model?.MovTitle</h1>

                <div class="d-flex flex-wrap align-items-center gap-3 text-secondary small mb-4">
                    <span><i class="bi bi-clock text-warning me-1"></i> @(Model?.MovDuration) minutes</span>
                    <span>•</span>
                    <span><i class="bi bi-calendar3 text-warning me-1"></i> Released: @(Model?.MovRelDate.ToString("dd MMM yyyy") ?? "-")</span>
                </div>

                <div class="mb-4">
                    <h5 class="text-white fw-bold font-display mb-2">Synopsis</h5>
                    <p class="text-secondary leading-relaxed" style="font-size: 0.95rem; line-height: 1.7;">
                        @(string.IsNullOrEmpty(Model?.MovDescription) ? "No synopsis provided for this movie." : Model.MovDescription)
                    </p>
                </div>

                <!-- Available Shows Section -->
                @if (Model?.ShowSchedules != null && Model.ShowSchedules.Any(s => s.ShowIsActive))
                {
                    <div class="mb-4 p-3 rounded-3" style="background: var(--bg-surface-elevated); border: 1px solid var(--border-glass);">
                        <h6 class="text-warning fw-bold mb-3">Available Screenings</h6>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var show in Model.ShowSchedules.Where(s => s.ShowIsActive).OrderBy(s => s.ShowDate).ThenBy(s => s.ShowStartTime))
                            {
                                <a asp-controller="Booking"
                                   asp-action="SelectSeats"
                                   asp-route-showScheduleId="@show.ShowScheduleId"
                                   class="btn btn-dark-outline btn-sm">
                                    <i class="bi bi-ticket-perforated text-warning me-1"></i>
                                    @show.ShowDate.ToString("dd MMM") • @show.ShowStartTime.ToString(@"hh\:mm")
                                    <small class="text-muted ms-1">(@(show.Screen?.Theatre?.TheaName ?? "Cinema"))</small>
                                </a>
                            }
                        </div>
                    </div>
                }

                <div class="d-flex flex-wrap gap-2 pt-3 border-top border-secondary border-opacity-25">
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model?.MovieId" class="btn btn-primary-cinema">
                            <i class="bi bi-pencil me-1"></i> Edit Movie
                        </a>
                    }
                    <a asp-controller="Home" asp-action="Index" class="btn btn-dark-outline">
                        <i class="bi bi-calendar-event me-1"></i> View All Shows On Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>