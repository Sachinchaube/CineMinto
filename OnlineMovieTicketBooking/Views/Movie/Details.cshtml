@model OnlineMovieTicketBooking.ViewModels.MovieVM

@{
    ViewData["Title"] = Model?.MovTitle ?? "Movie Details";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-cinema-secondary btn-cinema-sm">
        <i class="bi bi-arrow-left"></i> Back to Catalogue
    </a>
</div>

<div class="admin-card p-4 p-md-5">
    <div class="row g-4">
        <!-- Movie Poster Column -->
        <div class="col-md-4 col-lg-3 text-center">
            <div class="movie-poster-container rounded-4 shadow-lg overflow-hidden border border-secondary border-opacity-25" style="max-width: 280px; margin: 0 auto;">
                @if (!string.IsNullOrEmpty(Model?.MovPosterUrl))
                {
                    <img src="@Model.MovPosterUrl"
                         alt="@Model.MovTitle"
                         class="movie-poster-img"
                         onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'movie-poster-fallback\'><i class=\'bi bi-film\'></i></div>';" />
                }
                else
                {
                    <div class="movie-poster-fallback">
                        <i class="bi bi-film"></i>
                    </div>
                }
            </div>
        </div>

        <!-- Movie Details Column -->
        <div class="col-md-8 col-lg-9">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                @if (!string.IsNullOrEmpty(Model?.MovGenre))
                {
                    <span class="badge bg-secondary bg-opacity-25 text-white">@Model.MovGenre</span>
                }
                @if (!string.IsNullOrEmpty(Model?.MovLanguage))
                {
                    <span class="badge bg-danger bg-opacity-25 text-danger">@Model.MovLanguage</span>
                }
                @if (Model?.MovIsActive == true)
                {
                    <span class="status-badge success">Now Showing</span>
                }
                else
                {
                    <span class="status-badge cancelled">Inactive</span>
                }
            </div>

            <h1 class="hero-title mb-2">@Model?.MovTitle</h1>

            <div class="d-flex flex-wrap align-items-center gap-3 text-secondary small mb-4">
                <span><i class="bi bi-clock text-danger me-1"></i> @(Model?.MovDuration) minutes</span>
                <span>•</span>
                <span><i class="bi bi-calendar3 text-warning me-1"></i> Released: @(Model?.MovRelDate.ToString("dd MMM yyyy") ?? "-")</span>
            </div>

            <div class="mb-4">
                <h6 class="text-white fw-bold font-display mb-2">Synopsis</h6>
                <p class="text-secondary leading-relaxed" style="font-size: 1rem; line-height: 1.7;">
                    @(string.IsNullOrEmpty(Model?.MovDescription) ? "No synopsis provided for this movie." : Model.MovDescription)
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2 pt-3 border-top border-secondary border-opacity-25">
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@Model?.MovieId" class="btn btn-cinema">
                        <i class="bi bi-pencil"></i> Edit Movie
                    </a>
                }
                <a asp-controller="Home" asp-action="Index" class="btn btn-cinema-secondary">
                    <i class="bi bi-calendar-event"></i> Check Available Shows
                </a>
            </div>
        </div>
    </div>
</div>