@model OnlineMovieTicketBooking.ViewModels.RegisterVM

@{
    ViewData["Title"] = "Create Account";
}

<div class="auth-page-wrap">
    <div class="auth-clean-card" style="max-width: 480px;">

        <div class="text-center mb-4">
            <div class="d-flex justify-content-center mb-3">
                <div class="logo-mark" style="width: 52px; height: 52px;">
                    <svg width="52" height="52" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="regGoldGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#FFE8A3" />
                                <stop offset="40%" stop-color="#F3B768" />
                                <stop offset="100%" stop-color="#D97706" />
                            </linearGradient>
                            <linearGradient id="regGoldGrad2" x1="100%" y1="0%" x2="0%" y2="100%">
                                <stop offset="0%" stop-color="#FFFBEB" />
                                <stop offset="60%" stop-color="#E5A65D" />
                                <stop offset="100%" stop-color="#92400E" />
                            </linearGradient>
                        </defs>
                        <path d="M22 6C12.06 6 4 14.06 4 24C4 33.94 12.06 42 22 42C27.5 42 32.4 39.6 35.8 35.8L30.8 31.2C28.5 33.6 25.4 35 22 35C15.92 35 11 30.08 11 24C11 17.92 15.92 13 22 13C25.4 13 28.5 14.4 30.8 16.8L35.8 12.2C32.4 8.4 27.5 6 22 6Z" fill="url(#regGoldGrad1)" />
                        <path d="M25 16.5L42 8V40L25 31.5V16.5Z" fill="url(#regGoldGrad2)" />
                        <polygon points="19,16.5 28,24 19,31.5" fill="#FFFFFF" />
                    </svg>
                </div>
            </div>
            <h2 class="auth-heading">Create Account</h2>
        </div>

        <form asp-controller="Account" asp-action="Register" method="post">

            <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger bg-opacity-10 border border-danger border-opacity-25 text-danger small py-2 mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label-clean">Full Name</label>
                <input asp-for="FullName"
                       class="form-control form-control-clean"
                       placeholder="e.g. John Doe" />
                <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label-clean">Email Address</label>
                <input asp-for="Email"
                       class="form-control form-control-clean"
                       placeholder="name@example.com" />
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label-clean">Phone Number</label>
                <input asp-for="PhoneNumber"
                       class="form-control form-control-clean"
                       placeholder="9876543210" />
                <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <label asp-for="Password" class="form-label-clean">Password</label>
                    <input asp-for="Password"
                           type="password"
                           class="form-control form-control-clean"
                           placeholder="Min 8 chars" />
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-sm-6">
                    <label asp-for="ConfirmPassword" class="form-label-clean">Confirm</label>
                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control form-control-clean"
                           placeholder="Re-enter" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <button type="submit"
                    class="btn-auth-submit">
                Create Account
            </button>

        </form>

        <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25">
            <p class="text-secondary small mb-0">
                Already have an account?
                <a asp-controller="Account"
                   asp-action="Login"
                   class="text-warning fw-bold text-decoration-none ms-1">
                    Sign In
                </a>
            </p>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}