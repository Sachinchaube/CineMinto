@{
    ViewData["Title"] = "Access Restricted";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5 text-center">
            <div class="admin-card p-5 border-danger border-opacity-30">
                <div class="d-inline-flex p-4 rounded-circle bg-danger bg-opacity-10 text-danger mb-4">
                    <i class="bi bi-shield-slash fs-1"></i>
                </div>

                <h2 class="fw-bold text-white mb-2">Access Restricted</h2>

                <p class="text-muted mb-4">
                    You do not have administrative credentials or authorized permissions to access this cinema section.
                </p>

                <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-primary-cinema px-4">
                        <i class="bi bi-house-door me-1"></i> Return to Movies
                    </a>
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-dark-outline px-4">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Switch Account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>