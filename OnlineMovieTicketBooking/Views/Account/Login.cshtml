@model OnlineMovieTicketBooking.ViewModels.LoginVM

@{
    ViewData["Title"] = "Account Sign In";
}

<div class="auth-page-wrap">
    <div class="auth-clean-card text-center">

        <!-- Top Film Icon from Image 3 -->
        <div class="auth-icon-wrap">
            <i class="bi bi-film"></i>
        </div>

        <h2 class="auth-heading mb-4">Account Sign In</h2>

        <form asp-controller="Account"
              asp-action="Login"
              asp-route-returnUrl="@ViewBag.ReturnUrl"
              method="post"
              class="text-start">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger bg-danger bg-opacity-10 border border-danger border-opacity-25 text-danger small py-2 mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label-clean">Email Address</label>
                <input asp-for="Email"
                       class="form-control form-control-clean"
                       placeholder="Enter your email" />
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label-clean">Password</label>
                <input asp-for="Password"
                       type="password"
                       class="form-control form-control-clean"
                       placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4 form-check d-flex align-items-center gap-2">
                <input asp-for="RememberMe"
                       class="form-check-input form-check-input-clean m-0" />
                <label asp-for="RememberMe"
                       class="form-check-label text-secondary small mb-0">
                    Remember me
                </label>
            </div>

            <button type="submit"
                    class="btn-auth-submit">
                Sign In
            </button>

        </form>

        <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25">
            <p class="text-secondary small mb-0">
                Don't have an account?
                <a asp-controller="Account"
                   asp-action="Register"
                   class="text-warning fw-bold text-decoration-none ms-1">
                    Create Account
                </a>
            </p>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}