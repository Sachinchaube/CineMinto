@model OnlineMovieTicketBooking.ViewModels.LoginVM

@{
    ViewData["Title"] = "Account Sign In";
}

<div class="auth-page-wrap">
    <div class="auth-clean-card text-center">

        <!-- Top CineMento Brand Emblem -->
        <div class="d-flex justify-content-center mb-3">
            <div class="logo-mark" style="width: 52px; height: 52px;">
                <svg width="52" height="52" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="loginGoldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#FFF4D0" />
                            <stop offset="35%" stop-color="#F3B768" />
                            <stop offset="70%" stop-color="#E5A65D" />
                            <stop offset="100%" stop-color="#A26218" />
                        </linearGradient>
                        <linearGradient id="loginDarkGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#192640" />
                            <stop offset="100%" stop-color="#0B111E" />
                        </linearGradient>
                    </defs>
                    <rect x="2.5" y="2.5" width="43" height="43" rx="12" fill="url(#loginDarkGrad)" stroke="url(#loginGoldGrad)" stroke-width="1.8" />
                    <path d="M13 24C13 16.82 17.92 11 24 11C28.2 11 31.8 13.1 33.9 16.4L29.6 19.1C28.3 17.2 26.3 16 24 16C19.58 16 16 19.58 16 24C16 28.42 19.58 32 24 32C26.3 32 28.3 30.8 29.6 28.9L33.9 31.6C31.8 34.9 28.2 37 24 37C17.92 37 13 31.18 13 24Z" fill="url(#loginGoldGrad)" />
                    <path d="M30 18L37 13V35L30 30V18Z" fill="url(#loginGoldGrad)" opacity="0.9" />
                    <polygon points="24,18.5 28.5,24 24,29.5 19.5,24" fill="#FFFFFF" opacity="0.95" />
                    <polygon points="24,20.2 27,24 24,27.8 21,24" fill="url(#loginGoldGrad)" />
                </svg>
            </div>
        </div>

        <h2 class="auth-heading mb-4">Account Sign In</h2>

        <form asp-controller="Account"
              asp-action="Login"
              asp-route-returnUrl="@ViewBag.ReturnUrl"
              method="post"
              class="text-start">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger bg-danger bg-opacity-10 border border-danger border-opacity-25 text-danger small py-2 mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label-clean">Email Address</label>
                <input asp-for="Email"
                       class="form-control form-control-clean"
                       placeholder="Enter your email" />
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label-clean">Password</label>
                <input asp-for="Password"
                       type="password"
                       class="form-control form-control-clean"
                       placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4 form-check d-flex align-items-center gap-2">
                <input asp-for="RememberMe"
                       class="form-check-input form-check-input-clean m-0" />
                <label asp-for="RememberMe"
                       class="form-check-label text-secondary small mb-0">
                    Remember me
                </label>
            </div>

            <button type="submit"
                    class="btn-auth-submit">
                Sign In
            </button>

        </form>

        <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25">
            <p class="text-secondary small mb-0">
                Don't have an account?
                <a asp-controller="Account"
                   asp-action="Register"
                   class="text-warning fw-bold text-decoration-none ms-1">
                    Create Account
                </a>
            </p>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}