@model OnlineMovieTicketBooking.ViewModels.TheatreVM

@{
    ViewData["Title"] = "Add New Theatre";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-cinema-secondary btn-cinema-sm">
        <i class="bi bi-arrow-left"></i> Back to Theatres
    </a>
</div>

<div class="row">
    <div class="col-lg-6 mx-auto">
        <div class="admin-card">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                <div class="cinema-brand-icon" style="width: 42px; height: 42px; font-size: 1.25rem;">
                    <i class="bi bi-building-add"></i>
                </div>
                <div>
                    <h3 class="text-white fw-bold mb-0 font-display">Add Theatre Branch</h3>
                    <p class="text-secondary small mb-0">Register a new cinema location or partner multiplex.</p>
                </div>
            </div>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="TheaName" class="form-label">
                        <i class="bi bi-building"></i> Theatre Name
                    </label>
                    <input asp-for="TheaName" class="form-control" placeholder="e.g. Cineplex IMAX Downtown, PVR Icon" />
                    <span asp-validation-for="TheaName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TheaCIty" class="form-label">
                        <i class="bi bi-geo-alt"></i> City
                    </label>
                    <input asp-for="TheaCIty" class="form-control" placeholder="e.g. Mumbai, New York, London" />
                    <span asp-validation-for="TheaCIty" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TheaAddress" class="form-label">
                        <i class="bi bi-map"></i> Street Address & Landmark
                    </label>
                    <textarea asp-for="TheaAddress" class="form-control" rows="3" placeholder="e.g. 4th Floor, Nexus Mall, Grand Central Road"></textarea>
                    <span asp-validation-for="TheaAddress" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <div class="form-check form-switch p-0 d-flex align-items-center gap-3">
                        <input asp-for="TheaIsActive" class="form-check-input ms-0" type="checkbox" style="width: 2.5em; height: 1.3em;" id="theaActiveSwitch" />
                        <label class="form-check-label text-white fw-bold" for="theaActiveSwitch">
                            Active / Operational Branch
                        </label>
                    </div>
                    <span asp-validation-for="TheaIsActive" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 pt-3 border-top border-secondary border-opacity-25">
                    <button type="submit" class="btn btn-cinema">
                        <i class="bi bi-check-lg"></i> Create Theatre
                    </button>
                    <a asp-action="Index" class="btn btn-cinema-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}