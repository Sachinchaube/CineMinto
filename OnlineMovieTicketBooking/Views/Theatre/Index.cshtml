@model IEnumerable<OnlineMovieTicketBooking.ViewModels.TheatreVM>

@{
    ViewData["Title"] = "Theatres Management";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="nav-admin-badge">ADMIN</span>
            <h2 class="text-white fw-bold mb-0 font-display">Cinema Theatres</h2>
        </div>
        <p class="text-secondary small mb-0">Manage partner cinemas, locations, screens, and active statuses.</p>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-cinema">
            <i class="bi bi-plus-lg"></i> Add New Theatre
        </a>
    }
</div>

@if (Model == null || !Model.Any())
{
    <div class="admin-card text-center py-5">
        <i class="bi bi-building text-muted display-4 mb-3"></i>
        <h4 class="text-white font-display">No Theatres Registered</h4>
        <p class="text-secondary">Start by adding your first theatre branch.</p>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-cinema">
                <i class="bi bi-plus-lg"></i> Add Theatre
            </a>
        }
    </div>
}
else
{
    <div class="admin-card">
        <div class="table-responsive">
            <table class="cinema-table">
                <thead>
                    <tr>
                        <th>Theatre Name</th>
                        <th>City</th>
                        <th>Address</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="cinema-brand-icon" style="width: 36px; height: 36px; font-size: 1rem; border-radius: 8px;">
                                        <i class="bi bi-building"></i>
                                    </div>
                                    <div>
                                        <h6 class="text-white fw-bold mb-0">@item.TheaName</h6>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-secondary bg-opacity-25 text-white">
                                    <i class="bi bi-geo-alt text-danger me-1"></i>@item.TheaCIty
                                </span>
                            </td>
                            <td>
                                <span class="text-secondary small">@item.TheaAddress</span>
                            </td>
                            <td>
                                @if (item.TheaIsActive)
                                {
                                    <span class="status-badge success">Active</span>
                                }
                                else
                                {
                                    <span class="status-badge cancelled">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@item.TheatreId" class="btn btn-cinema-secondary btn-cinema-sm" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.TheatreId" class="btn btn-cinema-secondary btn-cinema-sm" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.TheatreId" class="btn btn-cinema-danger btn-cinema-sm" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}