@model IEnumerable<OnlineMovieTicketBooking.ViewModels.TheatreVM>

@{
    ViewData["Title"] = "Theatres Management";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="section-subtitle">THEATRES</div>
            <h2 class="text-white fw-bold mb-1 font-display">
                Cinema Theatres
            </h2>
            <p class="text-secondary small mb-0">Manage partner cinemas, locations, screens, and active statuses.</p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary-cinema">
                <i class="bi bi-plus-lg me-1"></i> Add New Theatre
            </a>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="admin-card text-center py-5 p-4">
            <i class="bi bi-buildings text-muted fs-1 mb-3 d-block"></i>
            <h4 class="text-white font-display">No Theatres Registered</h4>
            <p class="text-secondary small mb-4">Start by adding your first theatre branch.</p>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-primary-cinema">
                    <i class="bi bi-plus-lg me-1"></i> Add Theatre
                </a>
            }
        </div>
    }
    else
    {
        <div class="admin-card">
            <div class="table-responsive">
                <table class="cinema-table">
                    <thead>
                        <tr>
                            <th>Theatre Name</th>
                            <th>City</th>
                            <th>Address</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="logo-box" style="width: 34px; height: 34px; font-size: 0.9rem;">
                                            <i class="bi bi-buildings"></i>
                                        </div>
                                        <div>
                                            <h6 class="text-white fw-bold mb-0">@item.TheaName</h6>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-dark border border-secondary border-opacity-50 text-light">
                                        <i class="bi bi-geo-alt text-warning me-1"></i>@item.TheaCIty
                                    </span>
                                </td>
                                <td>
                                    <span class="text-secondary small">@item.TheaAddress</span>
                                </td>
                                <td>
                                    @if (item.TheaIsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-muted border border-secondary border-opacity-25 px-2 py-1">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@item.TheatreId" class="btn btn-dark-outline btn-sm" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.TheatreId" class="btn btn-dark-outline btn-sm" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.TheatreId" class="btn btn-danger btn-sm" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>