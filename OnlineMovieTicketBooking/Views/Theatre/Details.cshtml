@model OnlineMovieTicketBooking.ViewModels.TheatreVM

@{
    ViewData["Title"] = Model?.TheaName ?? "Theatre Details";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-cinema-secondary btn-cinema-sm">
        <i class="bi bi-arrow-left"></i> Back to Theatres
    </a>
</div>

<div class="row">
    <div class="col-lg-6 mx-auto">
        <div class="admin-card">
            <div class="d-flex align-items-center gap-2 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                <div class="cinema-brand-icon" style="width: 36px; height: 36px; font-size: 1.1rem;">
                    <i class="bi bi-building"></i>
                </div>
                <div>
                    <h3 class="text-white fw-bold mb-0 font-display">@Model?.TheaName</h3>
                    <p class="text-secondary small mb-0">Theatre Branch Profile</p>
                </div>
            </div>

            <div class="p-3 bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-25 mb-4">
                <div class="d-flex justify-content-between mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                    <span class="text-muted small">Theatre Name</span>
                    <strong class="text-white">@Model?.TheaName</strong>
                </div>
                <div class="d-flex justify-content-between mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                    <span class="text-muted small">City</span>
                    <span class="text-white">@Model?.TheaCIty</span>
                </div>
                <div class="d-flex justify-content-between mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                    <span class="text-muted small">Address</span>
                    <span class="text-white text-end" style="max-width: 280px;">@Model?.TheaAddress</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted small">Status</span>
                    @if (Model?.TheaIsActive == true)
                    {
                        <span class="status-badge success">Active</span>
                    }
                    else
                    {
                        <span class="status-badge cancelled">Inactive</span>
                    }
                </div>
            </div>

            <div class="d-flex gap-2">
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@Model?.TheatreId" class="btn btn-cinema">
                        <i class="bi bi-pencil"></i> Edit Theatre
                    </a>
                }
                <a asp-action="Index" class="btn btn-cinema-secondary">
                    Back to Theatres
                </a>
            </div>
        </div>
    </div>
</div>